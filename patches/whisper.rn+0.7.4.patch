+// Maps a model name to whisper.cpp's alignment-heads preset. Unknown names
+// leave DTW off rather than guess, because a wrong head set gives timestamps
+// that look plausible and are not.
+inline whisper_alignment_heads_preset dtwPresetFromName(const std::string &name) {
+    if (name == "tiny.en") return WHISPER_AHEADS_TINY_EN;
+    if (name == "tiny") return WHISPER_AHEADS_TINY;
+    if (name == "base.en") return WHISPER_AHEADS_BASE_EN;
+    if (name == "base") return WHISPER_AHEADS_BASE;
+    if (name == "small.en") return WHISPER_AHEADS_SMALL_EN;
+    if (name == "small") return WHISPER_AHEADS_SMALL;
+    if (name == "medium.en") return WHISPER_AHEADS_MEDIUM_EN;
+    if (name == "medium") return WHISPER_AHEADS_MEDIUM;
+    if (name == "large-v1") return WHISPER_AHEADS_LARGE_V1;
+    if (name == "large-v2") return WHISPER_AHEADS_LARGE_V2;
+    if (name == "large-v3") return WHISPER_AHEADS_LARGE_V3;
+    if (name == "large-v3-turbo") return WHISPER_AHEADS_LARGE_V3_TURBO;
+    return WHISPER_AHEADS_NONE;
+}
+
+inline void applyDtwPreset(whisper_context_params &params, const std::string &name) {
+    const auto preset = dtwPresetFromName(name);
+    params.dtw_token_timestamps = preset != WHISPER_AHEADS_NONE;
+    params.dtw_aheads_preset = preset;
+}
